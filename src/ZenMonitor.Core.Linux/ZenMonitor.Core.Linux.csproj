<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>ZenMonitor.Core.Linux</RootNamespace>

    <!-- NuGet Package Metadata -->
    <PackageId>ZenMonitor.Core.Linux</PackageId>
    <Description>Linux platform services and implementations for ZenMonitor.Core.</Description>
    <PackageTags>system-monitoring;telemetry;linux;hardware</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.IO.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZenMonitor.Core\ZenMonitor.Core.csproj" />
  </ItemGroup>

</Project>