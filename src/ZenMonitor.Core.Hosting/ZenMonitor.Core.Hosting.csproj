<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>ZenMonitor.Core.Hosting</RootNamespace>

    <!-- NuGet Package Metadata -->
    <PackageId>ZenMonitor.Core.Hosting</PackageId>
    <Version>1.0.2-alpha</Version>
    <Authors>ZenMonitor Contributors</Authors>
    <Description>Auto-detection and DI registration for ZenMonitor.Core platform services.</Description>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Akeoott/ZenMonitor.Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Akeoott/ZenMonitor.Core.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>system-monitoring;telemetry;hardware;hosting;di</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="9.0.3" />
    <PackageReference Include="System.IO.Abstractions"
      Version="22.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZenMonitor.Core\ZenMonitor.Core.csproj" />
    <ProjectReference Include="..\ZenMonitor.Core.Linux\ZenMonitor.Core.Linux.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>