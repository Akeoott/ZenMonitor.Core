<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>ZenMonitor.Core.Hosting</RootNamespace>

    <!-- NuGet Package Metadata -->
    <PackageId>ZenMonitor.Core.Hosting</PackageId>
    <Description>Auto-detection and DI registration for ZenMonitor.Core platform services.</Description>
    <PackageTags>system-monitoring;telemetry;hardware;hosting;di</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.IO.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZenMonitor.Core\ZenMonitor.Core.csproj" />
    <ProjectReference Include="..\ZenMonitor.Core.Linux\ZenMonitor.Core.Linux.csproj" />
    <ProjectReference Include="..\ZenMonitor.Core.Windows\ZenMonitor.Core.Windows.csproj" />
  </ItemGroup>

</Project>