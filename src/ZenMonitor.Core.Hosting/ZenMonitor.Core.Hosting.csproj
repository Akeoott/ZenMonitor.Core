<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>ZenMonitor.Core.Hosting</RootNamespace>

    <!-- NuGet Package Metadata -->
    <PackageId>ZenMonitor.Core.Hosting</PackageId>
    <Description>Auto-detection and DI registration for ZenMonitor.Core platform services.</Description>
    <PackageTags>system-monitoring;telemetry;hardware;hosting;di</PackageTags>
  </PropertyGroup>

  <Choose>
    <When Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <PropertyGroup>
        <DefineConstants>$(DefineConstants);PLATFORM_WINDOWS</DefineConstants>
      </PropertyGroup>
      <ItemGroup>
        <ProjectReference Include="..\ZenMonitor.Core.Windows\ZenMonitor.Core.Windows.csproj" />
      </ItemGroup>
    </When>
    <When Condition="$([MSBuild]::IsOSPlatform('Linux'))">
      <PropertyGroup>
        <DefineConstants>$(DefineConstants);PLATFORM_LINUX</DefineConstants>
      </PropertyGroup>
      <ItemGroup>
        <ProjectReference Include="..\ZenMonitor.Core.Linux\ZenMonitor.Core.Linux.csproj" />
      </ItemGroup>
    </When>
  </Choose>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.IO.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZenMonitor.Core\ZenMonitor.Core.csproj" />
  </ItemGroup>

</Project>